* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6f8;
    color: #222;
}

.header {
    background: #1f3c88;
    color: white;
    padding: 25px 40px;
}

.header h1 {
    margin-bottom: 6px;
}

.header p {
    opacity: 0.9;
}

.container {
    max-width: 1100px;
    margin: 30px auto;
    padding: 0 20px;
}

.patient-card,
.card,
.stat-card {
    background: white;
    border-radius: 12px;
    padding: 22px;
    margin-bottom: 25px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.patient-card h2,
.card h2 {
    margin-bottom: 15px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.stat-card {
    text-align: center;
}

.stat-card h3 {
    font-size: 16px;
    color: #666;
    margin-bottom: 10px;
}

.stat-card p {
    font-size: 28px;
    font-weight: bold;
    color: #1f3c88;
}

.chart-container {
    position: relative;
    height: 350px;
}

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

th {
    background: #f0f3f8;
}

tr:hover {
    background: #f8f9fb;
}

@media (max-width: 700px) {
    .stats {
        grid-template-columns: 1fr;
    }

    .header {
        padding: 20px;
    }

    .container {
        padding: 0 12px;
    }

    .chart-container {
        height: 280px;
    }
}
