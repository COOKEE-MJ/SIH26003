<!-- JAVASCRIPT -->

<script>


    /* ROLE DROPDOWN */

    function toggleRoleDropdown() {

        const dropdown =
            document.getElementById(
                'roleDropdown'
            );


        dropdown.classList.toggle(
            'hidden'
        );

    }



    function selectRole(role) {

        const selectedRole =
            document.getElementById(
                'selectedRole'
            );


        const roleIcon =
            document.getElementById(
                'roleIcon'
            );


        const dropdown =
            document.getElementById(
                'roleDropdown'
            );


        selectedRole.innerText =
            role;


        if (
            role === 'Doctor'
        ) {

            roleIcon.className =
                'fa-solid fa-user-doctor text-gray-700 text-sm';

        } else {

            roleIcon.className =
                'fa-regular fa-user text-gray-700 text-sm';

        }


        dropdown.classList.add(
            'hidden'
        );

    }



    /* CELEBRATION POPUP */

    function showCelebration() {

        document
            .getElementById(
                'celebrationPopup'
            )
            .classList
            .remove(
                'hidden'
            );

    }



    function closeCelebration() {

        document
            .getElementById(
                'celebrationPopup'
            )
            .classList
            .add(
                'hidden'
            );

    }



    /* GAME MENU */

    function openGameModal() {

        document
            .getElementById(
                'gameModal'
            )
            .classList
            .remove(
                'hidden'
            );


        showGameMenu();

    }



    function closeGameModal() {

        document
            .getElementById(
                'gameModal'
            )
            .classList
            .add(
                'hidden'
            );


        if (
            visualTimer
        ) {

            clearTimeout(
                visualTimer
            );

        }

    }



    function hideAllGames() {

        document
            .getElementById(
                'gameMenu'
            )
            .classList
            .add(
                'hidden'
            );


        document
            .getElementById(
                'memoryGame'
            )
            .classList
            .add(
                'hidden'
            );


        document
            .getElementById(
                'visualGame'
            )
            .classList
            .add(
                'hidden'
            );


        document
            .getElementById(
                'routineGame'
            )
            .classList
            .add(
                'hidden'
            );

    }



    function showGameMenu() {

        if (
            visualTimer
        ) {

            clearTimeout(
                visualTimer
            );

        }


        hideAllGames();


        document
            .getElementById(
                'gameMenu'
            )
            .classList
            .remove(
                'hidden'
            );

    }



    /* SHUFFLE FUNCTION */

    function shuffle(array) {

        const newArray =
            [...array];


        for (
            let i =
                newArray.length - 1;

            i >
                0;

            i--
        ) {

            const j =
                Math.floor(
                    Math.random() *
                    (
                        i + 1
                    )
                );


            [
                newArray[i],
                newArray[j]
            ] =
                [
                    newArray[j],
                    newArray[i]
                ];

        }


        return newArray;

    }



